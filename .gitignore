# Claude Code harness state — not part of the project
.claude_global/
**/.claude/settings.local.json

# Morch runtime state — local dev/test workspaces and the real generated
# config are not checked in. .morch/config.example.json (documentation
# fixture) is intentionally NOT covered by this and stays tracked.
.morch/config.json
.morch-disabled/

# Cowork's local git push credential (fine-grained GitHub PAT, contents +
# issues read/write, scoped to this repo only) — lives only on disk here,
# never committed. See .claude/skills/github-workflow/SKILL.md.
.morch-cowork-token

# Automated/scheduled coding-session logs (what was done, why, and any
# blockers) — local working notes, not project documentation. Never
# versioned; kept out of GitHub entirely per the automation's instructions.
session-logs/
